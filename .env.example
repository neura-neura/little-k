# Copy to .env. Never commit .env or Telegram session files.
# Create a Telegram application at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Your personal account ID (not Little K's account).
OWNER_USER_ID=
# Leave blank initially: interactive authorization discovers the dedicated account ID.
LITTLE_K_TELEGRAM_USER_ID=
TELEGRAM_SESSION_PATH=little-k.session
# Comma-separated numeric IDs. Groups normally use negative -100... IDs.
ALLOWED_CHAT_IDS=
ALLOWED_PRIVATE_USER_IDS=

# Native Hermes profile; inherits its model/provider/tools from Hermes.
HERMES_PROFILE=little-k
HERMES_BASE_URL=http://127.0.0.1:8642/p/little-k
HERMES_KEY_FILE=~/.hermes/profiles/little-k/.env
# Optional override instead of reading API_SERVER_KEY from HERMES_KEY_FILE.
HERMES_API_KEY=
HERMES_TIMEOUT=240

# macOS built-in voices. Install missing voices in System Settings.
VOICE_ENABLED=true
VOICE_IDLE_TIMEOUT=20
TTS_RATE=185
VOICE_ES=Paulina
VOICE_EN=Samantha
VOICE_ZH=Tingting
VOICE_JA=Kyoko
VOICE_KO=Yuna
VOICE_FR=Thomas
VOICE_DE=Anna
VOICE_PT=Luciana
VOICE_IT=Alice
# Empty means find ffmpeg on PATH.
FFMPEG_PATH=
DATABASE_PATH=data/state.sqlite3
LITTLE_K_SERVICE_LABEL=io.github.little-k.gateway
